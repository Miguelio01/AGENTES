# FRESCOH! AGENTES - Entorno de Producción
PORT=3000
NODE_ENV=production

# --- LLM PROVIDERS ---
# Opciones: NVIDIA, GEMINI, OLLAMA
LLM_PROVIDER=NVIDIA
NVIDIA_API_KEY=nvapi-xxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

GEMINI_API_KEY=xxxxxx

# --- PERSISTENCIA (MONGODB) ---
# Obligatorio para VPS: la sesión de WhatsApp se guardará aquí
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/frescoh?retryWrites=true&w=majority

# --- CANALES ---
WHATSAPP_API_TOKEN=true
TELEGRAM_BOT_TOKEN=xxxxxx
TELEGRAM_ORDERS_BOT_TOKEN=xxxxxx
TELEGRAM_ADMIN_ID=xxxxxx

# --- GOOGLE SHEETS (INVENTARIO) ---
# ID de la hoja de cálculo maestra
GOOGLE_SHEETS_SPREADSHEET_ID=xxxxxx
# IDs de los Partners (Gid)
PARTNER_FRESH_GID=0
PARTNER_EGGS_GID=xxxxxx

# --- KNOWLEDGE BASE ---
OBSIDIAN_VAULT_PATH=./brain
