generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      String   @default("USER") // "ADMIN" o "USER"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id                 String   @id
  name               String
  phone              String
  lid                String?
  fullName           String?
  documentType       String?
  documentNumber     String?
  email              String?
  address            String?
  city               String?
  registrationSource String?
  metadata           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  orders             Order[]
}

model SalesCycle {
  id                    String    @id @default(uuid())
  name                  String
  startDate             DateTime  @default(now())
  endDate               DateTime?
  status                String    @default("OPEN")
  manualSupplierPayment Float     @default(0)
  deliveryFee           Float     @default(10000)
  orders                Order[]
}

model Order {
  id                    String      @id
  clientId              String
  salesCycleId          String?
  agentId               String
  deliveryFee           Float       @default(0)
  total                 Float
  status                String      @default("pending")
  paymentConfirmationId String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  salesCycle            SalesCycle? @relation(fields: [salesCycleId], references: [id])
  client                Client      @relation(fields: [clientId], references: [id])
  items                 OrderItem[]
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  productId String
  name      String
  quantity  Float
  price     Float
  unitCost  Float  @default(0)
  order     Order  @relation(fields: [orderId], references: [id])
}

model InventoryItem {
  id              String   @id
  name            String
  stock           Float
  price           Float
  cost            Float    @default(0)
  sales           Float    @default(0)
  displayOrder    Int      @default(0)
  weightGrams     Float?
  unitsPerPackage Float?
  packagingType   String?
  description     String?
  category        String?
  updatedAt       DateTime @updatedAt
}
