<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              frescoh: {
                dark: '#005035',
                lime: '#B5F543',
                light: '#E6F4EA'
              }
            }
          }
        }
      }
    </script>
    <style>
        body { background-color: #f9fafb; font-family: 'Inter', sans-serif; }
        .card { background: white; border-radius: 1rem; border: 1px solid #e5e7eb; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); }
        .frescoh-gradient { background: linear-gradient(135deg, #005035 0%, #003622 100%); }
        [x-cloak] { display: none !important; }
    </style>
</head>
<body class="p-4 md:p-8" x-data="clientsApp()">
    
    <%- include('partials/ui-stack') %>

    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <header class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
            <div class="flex items-center gap-4">
                <img src="data:image/png;base64,<%= logo %>" class="w-16 h-16 rounded-full shadow-lg border-2 border-frescoh-lime" alt="Frescoh! Logo">
                <div>
                    <h1 class="text-3xl font-black text-frescoh-dark flex items-center gap-2 uppercase tracking-tight">
                        FRESCOH! <span class="text-frescoh-lime bg-frescoh-dark px-2 py-0.5 rounded">CLIENTES</span>
                    </h1>
                    <p class="text-gray-500 font-medium text-xs uppercase tracking-widest">Base de Datos para Facturación y Fidelización</p>
                </div>
            </div>
            
            <div class="flex flex-wrap items-center gap-3">
                <div class="flex items-center bg-white border border-gray-200 rounded-lg p-1 shadow-sm mr-2">
                  <div class="px-3 py-1 text-right">
                    <p class="text-[9px] font-black text-gray-400 uppercase leading-none">ADMINISTRADOR</p>
                    <p class="text-xs font-bold text-frescoh-dark truncate max-w-[100px]"><%= currentUser?.name || 'Miguel' %></p>
                  </div>
                  <a href="/auth/logout" class="bg-gray-50 hover:bg-red-50 text-gray-400 hover:text-red-500 p-2 rounded-md transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                  </a>
                </div>

                <a href="/admin/inventory" class="text-frescoh-dark hover:bg-frescoh-light px-4 py-2 rounded-lg font-bold transition border border-gray-200 bg-white shadow-sm text-xs uppercase tracking-tighter italic">Inventario</a>
                <a href="/admin/orders" class="text-frescoh-dark hover:bg-frescoh-light px-4 py-2 rounded-lg font-bold transition border border-gray-200 bg-white shadow-sm text-xs uppercase tracking-tighter italic">Órdenes</a>
            </div>
        </header>

        <main>
            <!-- Buscador y Stats -->
            <div class="flex flex-col md:flex-row gap-6 mb-8">
                <div class="flex-1 card p-6 flex items-center gap-4">
                    <div class="relative flex-1">
                        <input type="text" x-model="search" @keyup.enter="performSearch()" placeholder="Buscar por nombre, teléfono o documento..." class="w-full border border-gray-300 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-frescoh-dark outline-none bg-gray-50 shadow-inner">
                        <button @click="performSearch()" class="absolute right-3 top-2.5 bg-frescoh-dark text-white p-1.5 rounded-lg hover:opacity-90 transition">🔍</button>
                    </div>
                </div>
                <div class="card p-6 border-l-4 border-l-frescoh-lime flex flex-col justify-center min-w-[200px]">
                    <p class="text-gray-500 text-[10px] uppercase tracking-wider font-black">Clientes Registrados</p>
                    <p class="text-3xl font-bold text-frescoh-dark mt-1"><%= clients.length %></p>
                </div>
            </div>

            <!-- Tabla de Clientes -->
            <div class="card overflow-hidden border-t-4 border-t-frescoh-dark shadow-xl">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse min-w-[1000px]">
                        <thead class="bg-gray-50 border-b border-gray-200">
                            <tr>
                                <th class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest">Cliente / Teléfono</th>
                                <th class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest">Datos Facturación</th>
                                <th class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest">Ubicación</th>
                                <th class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest text-center">Pedidos</th>
                                <th class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200 bg-white">
                            <template x-for="client in clients" :key="client.id">
                                <tr class="hover:bg-frescoh-light/20 transition-all">
                                    <td class="px-6 py-5">
                                        <div class="font-black text-frescoh-dark text-sm" x-text="client.fullName || client.name"></div>
                                        <div class="flex items-center gap-1.5 mt-1">
                                            <span class="text-[10px] bg-green-100 text-green-700 px-1.5 py-0.5 rounded font-bold uppercase">WhatsApp</span>
                                            <span class="text-xs font-mono text-gray-500" x-text="client.phone"></span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-5">
                                        <template x-if="client.documentNumber">
                                            <div>
                                                <span class="text-[9px] font-black text-gray-400 uppercase" x-text="client.documentType || 'CC'"></span>
                                                <span class="text-xs font-bold text-gray-700 ml-1" x-text="client.documentNumber"></span>
                                            </div>
                                        </template>
                                        <template x-if="!client.documentNumber">
                                            <span class="text-[10px] text-orange-400 italic font-medium">⚠️ Sin datos tributarios</span>
                                        </template>
                                        <div class="text-[11px] text-gray-500 mt-1 truncate max-w-[200px]" x-text="client.email || 'Sin correo'"></div>
                                    </td>
                                    <td class="px-6 py-5">
                                        <div class="text-xs font-bold text-gray-700 truncate max-w-[250px]" x-text="client.address || 'Sin dirección'"></div>
                                        <div class="text-[10px] text-gray-400 uppercase font-black mt-0.5" x-text="client.city || 'Ubicación pendiente'"></div>
                                    </td>
                                    <td class="px-6 py-5 text-center">
                                        <span class="px-3 py-1 bg-frescoh-light text-frescoh-dark rounded-full font-black text-xs" x-text="client._count?.orders || 0"></span>
                                    </td>
                                    <td class="px-6 py-5 text-center">
                                        <button @click="editClient(client)" class="bg-white border border-gray-200 text-frescoh-dark p-2 rounded-xl shadow-sm hover:bg-frescoh-dark hover:text-white transition-all group">
                                            <span class="text-sm">✏️ Editar Datos</span>
                                        </button>
                                    </td>
                                </tr>
                            </template>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal Editar Cliente -->
    <div x-show="modal.show" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4" x-cloak x-transition>
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg border border-gray-200" @click.away="modal.show = false">
            <div class="frescoh-gradient p-6 text-white border-b border-frescoh-dark rounded-t-2xl">
                <h2 class="text-xl font-black uppercase tracking-tight italic">Actualizar Perfil de Cliente</h2>
                <p class="text-frescoh-lime/80 text-[10px] font-bold uppercase mt-1 tracking-widest">Sincronización de datos de facturación</p>
            </div>
            
            <form @submit.prevent="saveClient" class="p-8 space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="md:col-span-2">
                        <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-2">Nombre Completo / Razón Social</label>
                        <input type="text" x-model="modal.form.fullName" required class="w-full border-2 border-gray-100 rounded-xl p-3 focus:border-frescoh-dark outline-none bg-gray-50 text-sm font-bold shadow-inner">
                    </div>
                    
                    <div>
                        <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-2">Tipo Documento</label>
                        <select x-model="modal.form.documentType" class="w-full border-2 border-gray-100 rounded-xl p-3 focus:border-frescoh-dark outline-none bg-gray-50 text-sm font-bold shadow-inner">
                            <option value="CC">Cédula Ciudadanía</option>
                            <option value="NIT">NIT / RUT</option>
                            <option value="CE">Cédula Extranjería</option>
                            <option value="PP">Pasaporte</option>
                        </select>
                    </div>
                    
                    <div>
                        <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-2">Número Documento</label>
                        <input type="text" x-model="modal.form.documentNumber" class="w-full border-2 border-gray-100 rounded-xl p-3 focus:border-frescoh-dark outline-none bg-gray-50 text-sm font-bold shadow-inner">
                    </div>

                    <div class="md:col-span-2">
                        <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-2">Email para Facturas</label>
                        <input type="email" x-model="modal.form.email" class="w-full border-2 border-gray-100 rounded-xl p-3 focus:border-frescoh-dark outline-none bg-gray-50 text-sm font-bold shadow-inner">
                    </div>

                    <div>
                        <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-2">Ciudad</label>
                        <input type="text" x-model="modal.form.city" class="w-full border-2 border-gray-100 rounded-xl p-3 focus:border-frescoh-dark outline-none bg-gray-50 text-sm font-bold shadow-inner">
                    </div>

                    <div>
                        <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-2">Fuente de Registro</label>
                        <input type="text" x-model="modal.form.registrationSource" class="w-full border-2 border-gray-100 rounded-xl p-3 focus:border-frescoh-dark outline-none bg-gray-50 text-sm font-bold shadow-inner" placeholder="Ej: WhatsApp, Telegram...">
                    </div>

                    <div class="md:col-span-2">
                        <label class="block text-[10px] font-black text-gray-400 uppercase tracking-widest mb-2">Dirección Fiscal / Entrega</label>
                        <input type="text" x-model="modal.form.address" class="w-full border-2 border-gray-100 rounded-xl p-3 focus:border-frescoh-dark outline-none bg-gray-50 text-sm font-bold shadow-inner">
                    </div>
                </div>

                <div class="flex justify-end gap-3 mt-8 pt-6 border-t border-gray-100">
                    <button type="button" @click="modal.show = false" class="text-gray-400 font-bold text-xs uppercase tracking-widest hover:text-gray-600 transition">Cancelar</button>
                    <button type="submit" class="bg-frescoh-dark text-frescoh-lime px-8 py-3 rounded-xl font-black shadow-lg hover:scale-105 transition-all text-xs uppercase tracking-widest">
                        💾 Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function clientsApp() {
            return {
                clients: <%- JSON.stringify(clients) %>,
                search: '<%= search || "" %>',
                modal: {
                    show: false,
                    form: {}
                },

                performSearch() {
                    window.location.href = `/admin/clients?search=${encodeURIComponent(this.search)}`;
                },

                editClient(client) {
                    this.modal.form = { ...client };
                    this.modal.show = true;
                },

                async saveClient() {
                    try {
                        const response = await fetch(`/admin/clients/api/${this.modal.form.id}`, {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(this.modal.form)
                        });
                        
                        const result = await response.json();
                        
                        if (result.status === 'SUCCESS') {
                            window.frescohNotify({ 
                                title: '¡Éxito!', 
                                message: 'Datos del cliente actualizados correctamente ✅', 
                                type: 'success' 
                            });
                            setTimeout(() => location.reload(), 1000);
                        } else {
                            throw new Error(result.message);
                        }
                    } catch (e) {
                        window.frescohNotify({ 
                            title: 'Error al Guardar', 
                            message: e.message, 
                            type: 'error' 
                        });
                    }
                }
            }
        }
    </script>
</body>
</html>
