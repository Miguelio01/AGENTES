<%
  const strokeW = typeof strokeWidth !== 'undefined' ? strokeWidth : '2.5';
  const customClass = typeof className !== 'undefined' ? className : 'w-4 h-4';
%>
<svg class="<%= customClass %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
  <% if (name === 'plus') { %>
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="<%= strokeW %>" d="M12 6v12m6-6H6"></path>
  <% } else if (name === 'minus') { %>
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="<%= strokeW %>" d="M18 12H6"></path>
  <% } else if (name === 'search') { %>
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="<%= strokeW %>" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
  <% } else if (name === 'check') { %>
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="<%= strokeW %>" d="M5 13l4 4L19 7"></path>
  <% } else if (name === 'close') { %>
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="<%= strokeW %>" d="M6 18L18 6M6 6l12 12"></path>
  <% } else if (name === 'box') { %>
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="<%= strokeW %>" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
  <% } else if (name === 'chart') { %>
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="<%= strokeW %>" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
  <% } else if (name === 'user') { %>
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="<%= strokeW %>" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
  <% } else if (name === 'cart') { %>
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="<%= strokeW %>" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
  <% } else if (name === 'phone') { %>
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="<%= strokeW %>" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
  <% } else if (name === 'edit') { %>
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="<%= strokeW %>" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path>
  <% } else if (name === 'logout') { %>
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="<%= strokeW %>" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
  <% } else if (name === 'document') { %>
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="<%= strokeW %>" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
  <% } else if (name === 'log') { %>
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="<%= strokeW %>" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
  <% } %>
</svg>