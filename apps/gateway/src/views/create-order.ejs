<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head') %>
</head>
<body class="p-2 md:p-8" x-data="createOrderApp()">
    
    <%- include('partials/ui-stack') %>

    <div class="max-w-5xl mx-auto pb-32 md:pb-8">
        <!-- Header -->
        <header class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 md:mb-8 gap-4 px-2 md:px-0">
            <div class="flex items-center gap-3 md:gap-4">
                <img src="data:image/png;base64,<%= logo %>" class="w-12 h-12 md:w-16 md:h-16 rounded-full shadow-lg border-2 border-frescoh-lime" alt="Frescoh! Logo">
                <div>
                    <h1 class="text-2xl md:text-3xl font-black text-frescoh-dark flex items-center gap-2 uppercase tracking-tight">
                        FRESCOH! <span class="text-frescoh-lime bg-frescoh-dark px-2 py-0.5 rounded text-lg md:text-xl">PEDIDO</span>
                    </h1>
                    <p class="text-gray-500 font-medium text-[10px] md:text-xs">Creación Manual de Órdenes</p>
                </div>
            </div>
            
            <div class="flex items-center gap-2 w-full md:w-auto overflow-x-auto pb-2 md:pb-0 scrollbar-hide">
                <div class="flex items-center bg-white border border-gray-200 rounded-xl p-1 shadow-sm shrink-0">
                  <div class="px-3 py-1 text-right">
                    <p class="text-[8px] md:text-[9px] font-black text-gray-400 uppercase leading-none"><%= currentUser?.role === 'ADMIN' ? 'ADMIN' : 'VENDEDOR' %></p>
                    <p class="text-xs font-bold text-frescoh-dark truncate max-w-[80px] md:max-w-[100px]"><%= currentUser?.name || 'Usuario' %></p>
                  </div>
                  <a href="/auth/logout" class="bg-gray-50 hover:bg-red-50 text-gray-400 hover:text-red-500 p-2 rounded-lg transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                  </a>
                </div>

                <% if (currentUser?.role === 'ADMIN') { %>
                  <a href="/admin/orders" class="btn-secondary whitespace-nowrap !py-2 !px-3 shrink-0 italic">Órdenes</a>
                  <a href="/admin/inventory" class="btn-secondary whitespace-nowrap !py-2 !px-3 shrink-0 italic">Inventario</a>
                <% } %>
            </div>
        </header>

        <div class="flex flex-col md:grid md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
            
            <!-- Columna Izquierda: Cliente y Productos -->
            <div class="md:col-span-1 lg:col-span-2 space-y-6 order-2 md:order-1">
                
                <!-- Sección Cliente -->
                <div class="card p-4 md:p-6 border-l-4 border-l-frescoh-dark">
                    <h3 class="text-xs md:text-sm font-black text-frescoh-dark uppercase tracking-wider mb-4 flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg> Datos del Cliente
                    </h3>
                    
                    <div class="space-y-4">
                        <div class="relative">
                            <label class="block text-[10px] font-bold text-gray-400 uppercase mb-1">Buscar Cliente</label>
                            <div class="search-wrapper">
                                <span class="search-icon">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                                </span>
                                <input type="text" 
                                       x-model="clientSearch" 
                                       @input="findClient()"
                                       placeholder="Nombre o Teléfono..." 
                                       class="input-search">
                            </div>
                            
                            <!-- Dropdown de resultados -->
                            <div x-show="clientResults.length > 0" 
                                 x-cloak
                                 class="absolute z-20 w-full mt-1 bg-white border border-gray-200 rounded-xl shadow-2xl max-h-60 overflow-y-auto">
                                <template x-for="c in clientResults" :key="c.id">
                                    <div @click="selectClient(c)" class="px-4 py-3 hover:bg-frescoh-light cursor-pointer border-b border-gray-50 active:bg-gray-100">
                                        <p class="font-bold text-sm text-frescoh-dark" x-text="c.fullName || c.name"></p>
                                        <div class="flex items-center gap-2 mt-0.5">
                                            <span class="text-[9px] bg-gray-100 px-1.5 py-0.5 rounded font-mono text-gray-500" x-text="c.phone"></span>
                                            <span x-show="c.address" class="text-[9px] text-gray-400 truncate" x-text="c.address"></span>
                                        </div>
                                    </div>
                                </template>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-[10px] font-bold text-gray-400 uppercase mb-1">Nombre Completo</label>
                                <input type="text" x-model="order.clientName" class="input-base" placeholder="Nombre del cliente">
                            </div>
                            <div>
                                <label class="block text-[10px] font-bold text-gray-400 uppercase mb-1">WhatsApp / Teléfono</label>
                                <input type="tel" x-model="order.clientPhone" class="input-base" placeholder="300 000 0000">
                            </div>
                        </div>

                        <div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
                            <div class="col-span-1">
                                <label class="block text-[10px] font-bold text-gray-400 uppercase mb-1">Tipo Doc.</label>
                                <select x-model="order.clientDocType" class="input-base">
                                    <option value="">...</option>
                                    <option value="CC">CC</option>
                                    <option value="NIT">NIT</option>
                                    <option value="CE">CE</option>
                                </select>
                            </div>
                            <div class="col-span-1">
                                <label class="block text-[10px] font-bold text-gray-400 uppercase mb-1">Número</label>
                                <input type="text" x-model="order.clientDocNumber" class="input-base" placeholder="Documento">
                            </div>
                            <div class="col-span-2 lg:col-span-1">
                                <label class="block text-[10px] font-bold text-gray-400 uppercase mb-1">Email (Opcional)</label>
                                <input type="email" x-model="order.clientEmail" placeholder="correo@ejemplo.com" class="input-base">
                            </div>
                        </div>

                        <div>
                            <label class="block text-[10px] font-bold text-gray-400 uppercase mb-1">Dirección de Entrega</label>
                            <input type="text" x-model="order.clientAddress" class="input-base" placeholder="Calle, Carrera, Ciudad">
                        </div>
                    </div>
                </div>

                <!-- Selección de Productos -->
                <div class="card p-4 md:p-6 border-l-4 border-l-frescoh-lime">
                    <div class="flex justify-between items-center mb-4">
                        <h3 class="text-xs md:text-sm font-black text-frescoh-dark uppercase tracking-wider flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path></svg> Productos
                        </h3>
                        <span class="text-[9px] font-black bg-frescoh-light text-frescoh-dark px-2 py-0.5 rounded-full" x-text="`${filteredProducts.length} items` font-black"></span>
                    </div>

                    <div class="mb-4 md:mb-6">
                        <div class="search-wrapper">
                            <span class="search-icon">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                            </span>
                            <input type="text" x-model="productSearch" placeholder="Buscar producto..." class="input-search">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 md:gap-4 max-h-[500px] md:max-h-[600px] lg:max-h-[500px] overflow-y-auto pr-1 md:pr-2 scrollbar-hide">
                        <template x-for="product in filteredProducts" :key="product.id">
                            <div class="border border-gray-100 bg-gray-50/50 rounded-2xl p-4 flex justify-between items-center hover:border-frescoh-lime hover:bg-white transition-all group cursor-pointer active:scale-95"
                                 @click="addItem(product)">
                                <div class="flex-1">
                                    <p class="font-black text-frescoh-dark text-sm md:text-base leading-tight" x-text="product.name"></p>
                                    <div class="flex items-center gap-3 mt-1">
                                        <p class="text-xs font-bold text-frescoh-dark/70 font-mono" x-text="formatCurrency(product.price)"></p>
                                        <span class="w-1 h-1 bg-gray-300 rounded-full"></span>
                                        <p class="text-[10px] font-black uppercase tracking-tighter" :class="product.stock > 0 ? 'text-green-600' : 'text-red-500'" x-text="`Stock: ${product.stock}`"></p>
                                    </div>
                                </div>
                                <div class="bg-frescoh-dark text-frescoh-lime p-2.5 rounded-xl shadow-md group-hover:bg-frescoh-lime group-hover:text-frescoh-dark transition-all">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 6v12m6-6H6"></path></svg>
                                </div>
                            </div>
                        </template>
                    </div>
                </div>
            </div>

            <!-- Columna Derecha: Carrito y Totales -->
            <div class="order-1 md:order-2 md:col-span-1">
                <div class="card p-5 md:p-6 sticky top-4 md:top-8 bg-frescoh-dark text-white border-none shadow-2xl overflow-hidden min-h-[400px] flex flex-col">
                    <!-- Efecto de fondo decorativo -->
                    <div class="absolute -top-10 -right-10 w-32 h-32 bg-frescoh-lime/10 rounded-full blur-3xl"></div>
                    
                    <h3 class="text-xs md:text-sm font-black text-frescoh-lime uppercase tracking-widest mb-6 flex items-center gap-2 relative z-10">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg> Resumen del Pedido
                    </h3>

                    <div class="space-y-4 mb-8 overflow-y-auto pr-1 scrollbar-hide relative z-10 flex-grow max-h-[300px] md:max-h-none">
                        <template x-for="(item, index) in order.items" :key="index">
                            <div class="flex flex-col gap-2 border-b border-white/10 pb-4">
                                <div class="flex justify-between items-start">
                                    <p class="text-sm font-black leading-tight flex-1 pr-2" x-text="item.name"></p>
                                    <p class="text-xs font-mono font-bold text-frescoh-lime whitespace-nowrap" x-text="formatCurrency(item.price * item.quantity)"></p>
                                </div>
                                <div class="flex justify-between items-center">
                                    <%- include('components/qty-selector', { index: 'index', item: 'item', variant: 'dark' }) %>
                                    <button @click="removeItem(index)" class="text-[9px] bg-red-500/20 text-red-300 px-2 py-1 rounded-lg hover:bg-red-500 hover:text-white transition-all uppercase font-black">Quitar</button>
                                </div>
                            </div>
                        </template>
                        
                        <div x-show="order.items.length === 0" class="text-white/30 italic text-sm text-center py-10 flex flex-col items-center gap-2">
                            <svg class="w-8 h-8 opacity-20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 11-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
                            Carrito vacío
                        </div>
                    </div>

                    <div class="space-y-3 pt-4 border-t border-white/20 relative z-10">
                        <div class="flex justify-between items-center text-xs">
                            <span class="text-white/50 uppercase font-bold tracking-tighter">Subtotal</span>
                            <span class="font-mono font-bold" x-text="formatCurrency(subtotal)"></span>
                        </div>
                        <div class="flex justify-between items-center text-xs">
                            <span class="text-white/50 uppercase font-bold tracking-tighter">Envío</span>
                            <div class="flex items-center gap-2">
                                <span class="text-white/30 text-[10px]">$</span>
                                <input type="number" 
                                       x-model.number="order.deliveryFee" 
                                       class="w-20 bg-white/10 border border-white/20 rounded-lg px-2 py-1.5 text-right text-xs font-mono font-bold focus:ring-1 focus:ring-frescoh-lime outline-none">
                            </div>
                        </div>
                        <div class="flex justify-between items-center pt-5 border-t border-white/30">
                            <span class="font-black text-frescoh-lime text-[10px] uppercase tracking-widest">Total</span>
                            <span class="text-2xl md:text-3xl font-black font-mono text-frescoh-lime" x-text="formatCurrency(total)"></span>
                        </div>
                    </div>

                    <!-- Botón de Acción Responsivo -->
                    <div class="fixed bottom-4 left-4 right-4 z-50 md:static md:mt-8 md:z-auto">
                        <button @click="submitOrder()" 
                                :disabled="isSubmitting || order.items.length === 0 || !order.clientName || !order.clientPhone"
                                class="w-full bg-frescoh-lime text-frescoh-dark font-black py-4 md:py-5 rounded-2xl shadow-[0_10px_40px_rgba(181,245,67,0.3)] hover:shadow-frescoh-lime/50 active:scale-95 transition-all disabled:opacity-50 disabled:grayscale uppercase tracking-widest flex justify-center items-center gap-3 text-sm md:text-base border-2 border-frescoh-lime/50">
                            <span x-show="!isSubmitting" class="flex items-center gap-3">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                                <span class="md:hidden">Confirmar</span>
                                <span class="hidden md:inline">Enviar Pedido</span>
                            </span>
                            <span x-show="isSubmitting" class="flex items-center gap-3">
                                <svg class="animate-spin h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                </svg>
                            </span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function createOrderApp() {
            return {
                products: <%- JSON.stringify(products) %>,
                clients: <%- JSON.stringify(clients) %>,
                clientSearch: '',
                productSearch: '',
                clientResults: [],
                isSubmitting: false,
                order: {
                    clientName: '',
                    clientPhone: '',
                    clientAddress: '',
                    clientDocType: '',
                    clientDocNumber: '',
                    clientEmail: '',
                    deliveryFee: <%= deliveryFee %>,
                    items: []
                },

                formatCurrency(val) {
                    return new Intl.NumberFormat('es-CO', {
                        style: 'currency',
                        currency: 'COP',
                        minimumFractionDigits: 0
                    }).format(val);
                },

                showToast(message, type = 'info') {
                    window.dispatchEvent(new CustomEvent('notify', { 
                        detail: { 
                            title: type === 'success' ? 'Éxito' : 'Error',
                            message, 
                            type 
                        } 
                    }));
                },

                get filteredProducts() {
                    if (!this.productSearch) return this.products;
                    const s = this.productSearch.toLowerCase();
                    return this.products.filter(p => p.name.toLowerCase().includes(s) || p.id.toLowerCase().includes(s));
                },

                findClient() {
                    if (this.clientSearch.length < 2) {
                        this.clientResults = [];
                        return;
                    }
                    const s = this.clientSearch.toLowerCase();
                    this.clientResults = this.clients.filter(c => 
                        (c.name && c.name.toLowerCase().includes(s)) || 
                        (c.fullName && c.fullName.toLowerCase().includes(s)) || 
                        (c.phone && c.phone.includes(s))
                    ).slice(0, 5);
                },

                selectClient(c) {
                    this.order.clientName = c.fullName || c.name;
                    this.order.clientPhone = c.phone;
                    this.order.clientAddress = c.address || '';
                    this.order.clientDocType = c.documentType || '';
                    this.order.clientDocNumber = c.documentNumber || '';
                    this.order.clientEmail = c.email || '';
                    this.clientResults = [];
                    this.clientSearch = '';
                    this.showToast('Cliente cargado', 'success');
                },

                addItem(product) {
                    const existing = this.order.items.find(i => i.id === product.id);
                    if (existing) {
                        existing.quantity++;
                    } else {
                        this.order.items.push({
                            id: product.id,
                            name: product.name,
                            price: product.price,
                            quantity: 1
                        });
                    }
                    this.showToast(`Agregado: ${product.name}`, 'success');
                },

                updateItemQuantity(index, delta) {
                    const item = this.order.items[index];
                    item.quantity += delta;
                    if (item.quantity <= 0) {
                        this.removeItem(index);
                    }
                },

                removeItem(index) {
                    this.order.items.splice(index, 1);
                },

                get subtotal() {
                    return this.order.items.reduce((sum, i) => sum + (i.price * i.quantity), 0);
                },

                get total() {
                    return this.subtotal + (this.order.deliveryFee || 0);
                },

                async submitOrder() {
                    this.isSubmitting = true;
                    try {
                        const response = await fetch('/admin/orders/api/create', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(this.order)
                        });

                        const result = await response.json();
                        if (result.status === 'SUCCESS') {
                            this.showToast('¡Pedido creado con éxito!', 'success');
                            
                            // Limpiar el formulario para un nuevo pedido en lugar de redirigir
                            this.order = {
                                clientName: '',
                                clientPhone: '',
                                clientAddress: '',
                                clientDocType: '',
                                clientDocNumber: '',
                                clientEmail: '',
                                deliveryFee: <%= deliveryFee %>,
                                items: []
                            };
                            this.clientSearch = '';
                            this.productSearch = '';
                            this.isSubmitting = false;

                        } else {
                            throw new Error(result.message);
                        }
                    } catch (e) {
                        this.showToast(`Error: ${e.message}`, 'error');
                        this.isSubmitting = false;
                    }
                }
            }
        }
    </script>
</body>
</html>
