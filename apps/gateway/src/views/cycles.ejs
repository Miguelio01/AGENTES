<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              frescoh: {
                dark: '#005035',
                lime: '#B5F543',
                light: '#E6F4EA'
              }
            }
          }
        }
      }
    </script>
    <style>
        body { background-color: #f9fafb; font-family: 'Inter', sans-serif; }
        .card { background: white; border-radius: 1rem; border: 1px solid #e5e7eb; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); }
        .frescoh-gradient { background: linear-gradient(135deg, #005035 0%, #003622 100%); }
        [x-cloak] { display: none !important; }
    </style>
</head>
<body class="p-4 md:p-8" x-data="cyclesApp()">
    
    <%- include('partials/ui-stack') %>

    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <header class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
            <div class="flex items-center gap-4">
                <img src="data:image/png;base64,<%= logo %>" class="w-16 h-16 rounded-full shadow-lg border-2 border-frescoh-lime" alt="Frescoh! Logo">
                <div>
                    <h1 class="text-3xl font-black text-frescoh-dark flex items-center gap-2 uppercase tracking-tight">
                        FRESCOH! <span class="text-frescoh-lime bg-frescoh-dark px-2 py-0.5 rounded">COSECHAS</span>
                    </h1>
                    <p class="text-gray-500 font-medium text-xs">Gestión de Ciclos y Rentabilidad Neta</p>
                </div>
            </div>
            <div class="flex flex-wrap items-center gap-3">
                <div class="flex items-center bg-white border border-gray-200 rounded-lg p-1 shadow-sm mr-2">
                  <div class="px-3 py-1 text-right">
                    <p class="text-[9px] font-black text-gray-400 uppercase leading-none"><%= currentUser?.role === 'ADMIN' ? 'ADMINISTRADOR' : 'VENDEDOR' %></p>
                    <p class="text-xs font-bold text-frescoh-dark truncate max-w-[100px]"><%= currentUser?.name || 'Usuario' %></p>
                  </div>
                  <a href="/auth/logout" class="bg-gray-50 hover:bg-red-50 text-gray-400 hover:text-red-500 p-2 rounded-md transition-colors" title="Cerrar Sesión">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                  </a>
                </div>

                <a href="/admin/inventory" class="text-frescoh-dark hover:bg-frescoh-light px-4 py-2 rounded-lg font-bold transition border border-gray-200 bg-white shadow-sm text-xs uppercase tracking-tighter italic">Inventario</a>
                <a href="/admin/orders" class="text-frescoh-dark hover:bg-frescoh-light px-4 py-2 rounded-lg font-bold transition border border-gray-200 bg-white shadow-sm text-xs uppercase tracking-tighter italic">Órdenes</a>
                <a href="/admin/clients" class="text-frescoh-dark hover:bg-frescoh-light px-4 py-2 rounded-lg font-bold transition border border-gray-200 bg-white shadow-sm text-xs uppercase tracking-tighter italic">Clientes</a>
                
                <button x-show="!hasOpenCycle" @click="openModal('create')" class="bg-frescoh-dark text-frescoh-lime px-4 py-2 rounded-lg font-black shadow-lg hover:opacity-90 transition text-xs uppercase tracking-wide">
                    + Abrir Cosecha
                </button>
            </div>
        </header>

        <main>
            <!-- Tabla de Ciclos -->
            <div class="card overflow-hidden mb-12 border-l-4 border-l-frescoh-lime shadow-lg">
                <div class="bg-gray-50 px-6 py-4 border-b border-gray-200 flex justify-between items-center gap-4">
                    <h3 class="font-bold text-frescoh-dark uppercase tracking-tight">📊 Historial de Cosechas</h3>
                </div>
                
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse min-w-[1100px]">
                        <thead class="bg-gray-50 border-b border-gray-200">
                            <tr>
                                <th class="px-4 py-3 text-xs font-bold text-gray-500 uppercase">Estado</th>
                                <th class="px-4 py-3 text-xs font-bold text-gray-500 uppercase">Nombre</th>
                                <th class="px-4 py-3 text-xs font-bold text-gray-500 uppercase text-right">Venta Productos</th>
                                <th class="px-4 py-3 text-xs font-bold text-gray-500 uppercase text-right">Domicilios</th>
                                <th class="px-4 py-3 text-xs font-bold text-gray-500 uppercase text-right bg-orange-50/50">Pago Provedores</th>
                                <th class="px-4 py-3 text-xs font-bold text-gray-500 uppercase text-right">Utilidad Neta</th>
                                <th class="px-4 py-3 text-xs font-bold text-gray-500 uppercase text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200">
                            <template x-for="cycle in cycles" :key="cycle.id">
                                <tr class="hover:bg-frescoh-light/30 transition-colors" :class="{'bg-green-50/30': cycle.status === 'OPEN'}">
                                    <td class="px-4 py-4">
                                        <span class="px-2 py-1 rounded text-[9px] font-bold uppercase tracking-wider block w-max"
                                            :class="cycle.status === 'OPEN' ? 'bg-frescoh-lime text-frescoh-dark shadow-sm border border-frescoh-dark/10' : 'bg-gray-100 text-gray-500'" 
                                            x-text="cycle.status === 'OPEN' ? 'ACTIVA' : 'CERRADA'">
                                        </span>
                                    </td>
                                    <td class="px-4 py-4">
                                        <div class="font-bold text-gray-800 text-sm" x-text="cycle.name"></div>
                                        <div class="text-[9px] text-gray-500 font-medium mt-1">Config: <span class="font-bold" x-text="formatCurrency(cycle.deliveryFee)"></span>/domicilio</div>
                                        <button @click="openModal('edit', cycle)" class="text-[9px] text-indigo-600 hover:underline font-bold mt-1 uppercase tracking-tighter italic">Ajustar Cosecha ✏️</button>
                                    </td>
                                    
                                    <!-- Venta Productos -->
                                    <td class="px-4 py-4 text-right font-medium text-gray-700 text-sm" x-text="formatCurrency(cycle.metrics.productRevenue)"></td>
                                    
                                    <!-- Ingresos por Domicilios (Excluidos de utilidad) -->
                                    <td class="px-4 py-4 text-right font-medium text-blue-600 text-sm" x-text="formatCurrency(cycle.metrics.deliveryRevenue)"></td>
                                    
                                    <!-- Pago Proveedores (Editable Directamente) -->
                                    <td class="px-4 py-4 text-right bg-orange-50/30">
                                        <div x-show="!cycle.isEditingPayment" @click="cycle.isEditingPayment = true; cycle.newPaymentValue = cycle.manualSupplierPayment" class="group cursor-pointer">
                                            <span class="px-3 py-1.5 rounded text-[11px] font-black block ml-auto w-max border border-orange-200 bg-white text-orange-700 group-hover:border-orange-500 transition-all shadow-sm" 
                                                x-text="formatCurrency(cycle.manualSupplierPayment)">
                                            </span>
                                        </div>
                                        <div x-show="cycle.isEditingPayment" class="flex flex-col items-end gap-1">
                                            <div class="flex items-center gap-1 justify-end">
                                                <span class="text-[10px] font-bold text-orange-400">$</span>
                                                <input type="number" x-model.number="cycle.newPaymentValue" 
                                                       class="w-24 border border-orange-300 rounded text-right text-xs font-black text-orange-700 outline-none focus:ring-1 focus:ring-orange-500 bg-white">
                                            </div>
                                            <div class="flex gap-1">
                                                <button @click="savePayment(cycle)" class="bg-orange-500 text-white text-[9px] px-2 py-0.5 rounded font-black uppercase shadow-sm hover:opacity-90">OK</button>
                                                <button @click="cycle.isEditingPayment = false" class="text-[9px] text-gray-400 hover:text-red-500 font-bold uppercase">X</button>
                                            </div>
                                        </div>
                                    </td>
                                    
                                    <!-- Utilidad Neta -->
                                    <td class="px-4 py-4 text-right">
                                        <div class="font-black text-frescoh-dark text-base" x-text="formatCurrency(cycle.metrics.netProfit)"></div>
                                        <div class="text-[9px] font-bold mt-1" :class="cycle.metrics.margin > 0 ? 'text-green-600' : 'text-gray-400'" x-text="cycle.metrics.margin + '% Margen'"></div>
                                    </td>
                                    
                                    <td class="px-4 py-4 text-center">
                                        <!-- Botón Cerrar (Si está abierta) -->
                                        <button x-show="cycle.status === 'OPEN'" @click="closeCycle(cycle.id)" class="text-[9px] font-bold bg-white border border-red-200 text-red-600 px-3 py-1.5 rounded hover:bg-red-50 transition shadow-sm uppercase">
                                            Cerrar
                                        </button>

                                        <!-- Botón Reactivar (Si está cerrada) -->
                                        <button x-show="cycle.status === 'CLOSED'" @click="reopenCycle(cycle.id)" class="text-[9px] font-bold bg-frescoh-dark text-frescoh-lime px-3 py-1.5 rounded hover:opacity-90 transition shadow-sm uppercase">
                                            Reactivar
                                        </button>
                                    </td>
                                </tr>
                            </template>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal Ciclo (Crear/Editar) -->
    <div x-show="modal.show" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4" x-cloak x-transition>
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md border border-gray-200" @click.away="modal.show = false">
            <div class="frescoh-gradient p-6 text-white border-b border-frescoh-dark rounded-t-2xl">
                <h2 class="text-xl font-black uppercase tracking-tight" x-text="modal.mode === 'create' ? 'Nueva Cosecha' : 'Ajustar Cosecha'"></h2>
                <p class="text-frescoh-lime/80 text-xs font-medium uppercase mt-1">Control de periodos operativos</p>
            </div>
            <form @submit.prevent="saveCycle" class="p-6 space-y-4">
                <div>
                    <label class="block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-1">Nombre</label>
                    <input type="text" x-model="modal.form.name" required class="w-full border border-gray-300 rounded p-3 focus:ring-2 focus:ring-frescoh-dark outline-none bg-gray-50 text-sm font-bold" placeholder="Ej: Semana 23 - Mayo">
                </div>
                
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-1">Inicio</label>
                        <input type="datetime-local" x-model="modal.form.startDate" required class="w-full border border-gray-300 rounded p-3 focus:ring-2 focus:ring-frescoh-dark outline-none bg-gray-50 text-xs font-bold">
                    </div>
                    <div>
                        <label class="block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-1">Cierre</label>
                        <input type="datetime-local" x-model="modal.form.endDate" class="w-full border border-gray-300 rounded p-3 focus:ring-2 focus:ring-frescoh-dark outline-none bg-gray-50 text-xs font-bold">
                    </div>
                    <div>
                        <label class="block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-1">Costo Domicilio ($)</label>
                        <input type="number" x-model.number="modal.form.deliveryFee" placeholder="Ej: 10000" class="w-full border border-gray-300 rounded p-3 focus:ring-2 focus:ring-frescoh-dark outline-none bg-gray-50 text-xs font-bold">
                    </div>
                </div>

                <div class="flex justify-end gap-3 mt-6 pt-4 border-t border-gray-100">
                    <button type="button" @click="modal.show = false" class="text-gray-500 bg-gray-100 px-4 py-2 rounded hover:bg-gray-200 transition font-bold text-xs uppercase tracking-wide">Cancelar</button>
                    <button type="submit" class="bg-frescoh-dark text-frescoh-lime px-6 py-2 rounded font-black hover:opacity-90 shadow-md transition text-xs uppercase tracking-wide" x-text="modal.mode === 'create' ? 'Abrir Cosecha' : 'Guardar Cambios'"></button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function cyclesApp() {
            return {
                cycles: <%- JSON.stringify(cycles) %>,
                modal: {
                    show: false, mode: 'create',
                    form: { id: null, name: '', startDate: '', endDate: '', deliveryFee: 10000 }
                },

                init() {
                    this.cycles.forEach(c => {
                        c.isEditingPayment = false;
                        c.newPaymentValue = c.manualSupplierPayment || 0;
                    });
                },
                
                get hasOpenCycle() { return this.cycles.some(c => c.status === 'OPEN'); },

                formatCurrency(value) {
                    return new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', minimumFractionDigits: 0 }).format(value || 0);
                },

                formatDate(dateString) {
                    if (!dateString) return 'N/A';
                    const d = new Date(dateString);
                    return d.toLocaleDateString('es-CO', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
                },

                formatDateTimeLocal(dateString) {
                    if (!dateString) return '';
                    const d = new Date(dateString);
                    const pad = (n) => n.toString().padStart(2, '0');
                    return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
                },

                openModal(mode, cycle = null) {
                    this.modal.mode = mode;
                    if (mode === 'create') {
                        this.modal.form = {
                            id: null, name: '', startDate: this.formatDateTimeLocal(new Date()), endDate: ''
                        };
                    } else if (cycle) {
                        this.modal.form = {
                            id: cycle.id, name: cycle.name,
                            startDate: this.formatDateTimeLocal(cycle.startDate),
                            endDate: this.formatDateTimeLocal(cycle.endDate)
                        };
                    }
                    this.modal.show = true;
                },

                async saveCycle() {
                    const url = this.modal.mode === 'create' ? '/admin/cycles/api/open' : `/admin/cycles/api/${this.modal.form.id}`;
                    const method = this.modal.mode === 'create' ? 'POST' : 'PATCH';
                    try {
                        const response = await fetch(url, {
                            method: method,
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(this.modal.form)
                        });
                        
                        const result = await response.json();
                        
                        if (result.status === 'SUCCESS') {
                            window.dispatchEvent(new CustomEvent('notify', { 
                                detail: { title: 'Éxito', message: 'Cosecha guardada correctamente ✅', type: 'success' } 
                            }));
                            setTimeout(() => location.reload(), 1000);
                        } else {
                            window.dispatchEvent(new CustomEvent('notify', { 
                                detail: { title: 'Error de Validación', message: result.message, type: 'error' } 
                            }));
                        }
                    } catch (e) {
                        window.dispatchEvent(new CustomEvent('notify', { 
                            detail: { title: 'Error', message: 'Falla de conexión: ' + e.message, type: 'error' } 
                        }));
                    }
                },

                async savePayment(cycle) {
                    try {
                        const response = await fetch(`/admin/cycles/api/payment/${cycle.id}`, {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ payment: cycle.newPaymentValue })
                        });
                        
                        if (response.ok) {
                            cycle.manualSupplierPayment = cycle.newPaymentValue;
                            cycle.isEditingPayment = false;
                            window.dispatchEvent(new CustomEvent('notify', { 
                                detail: { title: 'Éxito', message: `Pago de ${cycle.name} actualizado`, type: 'success' } 
                            }));
                            setTimeout(() => location.reload(), 1000); // Recargar para ver nueva utilidad neta
                        }
                    } catch (e) {
                        alert('Error al guardar pago: ' + e.message);
                    }
                },

                async closeCycle(id) {
                    if (!confirm('¿Seguro que quieres cerrar esta cosecha?')) return;
                    try {
                        const response = await fetch(`/admin/cycles/api/${id}/close`, { method: 'POST' });
                        if (response.ok) { location.reload(); }
                    } catch (e) { alert('Error: ' + e.message); }
                },

                async reopenCycle(id) {
                    if (!confirm('¿Deseas reactivar esta cosecha? Esto cerrará cualquier otra cosecha que esté abierta.')) return;
                    try {
                        const response = await fetch(`/admin/cycles/api/${id}/reopen`, { method: 'POST' });
                        if (response.ok) {
                            window.dispatchEvent(new CustomEvent('notify', { 
                                detail: { title: 'Éxito', message: 'Cosecha reactivada ✅', type: 'success' } 
                            }));
                            setTimeout(() => location.reload(), 1000);
                        }
                    } catch (e) { alert('Error: ' + e.message); }
                }
            }
        }
    </script>
</body>
</html>
