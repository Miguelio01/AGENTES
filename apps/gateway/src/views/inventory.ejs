<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head') %>
</head>
<body class="p-4 md:p-8" x-data="inventoryApp()">
    
    <%- include('partials/ui-stack') %>

    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <header class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
            <div class="flex items-center gap-4">
                <img src="data:image/png;base64,<%= logo %>" class="w-16 h-16 rounded-full shadow-lg border-2 border-frescoh-lime" alt="Frescoh! Logo">
                <div>
                    <h1 class="text-3xl font-black text-frescoh-dark flex items-center gap-2 uppercase tracking-tight">
                        FRESCOH! <span class="text-frescoh-lime bg-frescoh-dark px-2 py-0.5 rounded">INVENTARIO</span>
                    </h1>
                    <div class="flex items-center gap-2 mt-1">
                        <p class="text-gray-500 font-medium text-xs">Catálogo Inteligente de Cosecha</p>
                        <% if (typeof activeCycle !== 'undefined' && activeCycle) { %>
                            <span class="text-[9px] bg-frescoh-lime/20 text-frescoh-dark border border-frescoh-lime px-2 py-0.5 rounded-full font-black uppercase tracking-widest">
                                🚜 Cosecha: <%= activeCycle.name %>
                            </span>
                        <% } %>
                    </div>
                </div>
            </div>
            <div class="flex flex-wrap items-center gap-3">
                <div class="flex items-center bg-white border border-gray-200 rounded-lg p-1 shadow-sm mr-2">
                  <div class="px-3 py-1 text-right">
                    <p class="text-[9px] font-black text-gray-400 uppercase leading-none"><%= currentUser?.role === 'ADMIN' ? 'ADMINISTRADOR' : 'VENDEDOR' %></p>
                    <p class="text-xs font-bold text-frescoh-dark truncate max-w-[100px]"><%= currentUser?.name || 'Usuario' %></p>
                  </div>
                  <a href="/auth/logout" class="bg-gray-50 hover:bg-red-50 text-gray-400 hover:text-red-500 p-2 rounded-md transition-colors" title="Cerrar Sesión">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                  </a>
                </div>

                <% if (currentUser?.role === 'ADMIN') { %>
                  <a href="/admin/cycles" class="text-frescoh-dark hover:bg-frescoh-light px-4 py-2 rounded-lg font-bold transition border border-gray-200 bg-white shadow-sm text-xs uppercase tracking-tighter italic">Cosechas</a>
                  <a href="/admin/orders" class="text-frescoh-dark hover:bg-frescoh-light px-4 py-2 rounded-lg font-bold transition border border-gray-200 bg-white shadow-sm text-xs uppercase tracking-tighter italic">Órdenes</a>
                  <a href="/admin/clients" class="text-frescoh-dark hover:bg-frescoh-light px-4 py-2 rounded-lg font-bold transition border border-gray-200 bg-white shadow-sm text-xs uppercase tracking-tighter italic">Clientes</a>
                <% } %>
                
                <%- include('components/button', { variant: 'primary', icon: 'plus', text: 'Nueva Orden', href: '/admin/orders/new' }) %>
            </div>
        </header>

        <main>
            <!-- Dashboard Stats & Chart -->
            <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 mb-8">
                <div class="lg:col-span-3 card p-6 relative overflow-hidden">
                    <div class="flex justify-between items-center mb-4 border-b pb-4">
                        <h2 class="text-lg font-bold text-frescoh-dark uppercase tracking-tight italic">Rendimiento de Inventario vs Ventas</h2>
                        <div class="flex gap-4 text-[9px] font-black uppercase tracking-widest">
                            <div class="flex items-center gap-1.5 text-frescoh-dark">
                                <span class="w-3 h-3 bg-frescoh-dark rounded-sm"></span> Stock
                            </div>
                            <div class="flex items-center gap-1.5 text-blue-600">
                                <span class="w-3 h-3 bg-blue-600 rounded-full"></span> Ventas
                            </div>
                        </div>
                    </div>
                    <div class="h-64">
                        <canvas id="stockChart"></canvas>
                    </div>
                    <!-- Decorative BG -->
                    <div class="absolute top-0 right-0 p-4 opacity-5 pointer-events-none">
                        <span class="text-6xl font-black italic tracking-tighter">DATA</span>
                    </div>
                </div>
                
                <div class="flex flex-col gap-4">
                    <div class="card p-4 border-l-4 border-l-frescoh-dark flex flex-col justify-center h-full">
                        <p class="text-gray-500 text-[10px] uppercase tracking-wider font-black text-center">Ítems Activos</p>
                        <p class="text-3xl font-bold text-frescoh-dark text-center mt-1" x-text="products.length"></p>
                    </div>
                    <div class="card p-4 border-l-4 border-l-frescoh-lime flex flex-col justify-center h-full bg-frescoh-light/10">
                        <p class="text-gray-500 text-[10px] uppercase tracking-wider font-black text-center">Vendido en Ciclo</p>
                        <p class="text-3xl font-bold text-frescoh-dark text-center mt-1" x-text="cycleSalesTotal"></p>
                    </div>
                    <div class="card p-4 border-l-4 border-l-blue-600 flex flex-col justify-center h-full bg-blue-50/20">
                        <p class="text-gray-500 text-[10px] uppercase tracking-wider font-black text-center">Stock Total</p>
                        <p class="text-3xl font-bold text-blue-600 text-center mt-1" x-text="totalStockValue"></p>
                    </div>
                </div>
            </div>

            <!-- Gestión de Inventario (Tabla Rediseñada) -->
            <div class="card overflow-hidden mb-12 border-t-4 border-t-frescoh-dark shadow-xl">
                <div class="bg-gray-50 px-6 py-5 border-b border-gray-200 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                    <div>
                        <h3 class="font-bold text-frescoh-dark uppercase tracking-tight flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
                            Panel de Operación 
                            <span class="text-[10px] bg-frescoh-dark text-white px-2 py-0.5 rounded font-black tracking-widest">REAL-TIME</span>
                        </h3>
                        <p class="text-gray-400 text-[10px] font-bold uppercase mt-1">Gestión de stock y disponibilidad en tiempo real</p>
                    </div>
                    <div class="w-full md:w-80">
                        <%- include('components/input-search', { model: 'search', placeholder: 'Filtrar catálogo...' }) %>
                    </div>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse min-w-[800px]">
                        <thead class="bg-gray-50 border-b border-gray-200">
                            <tr>
                                <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase">Producto / Identificador</th>
                                <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase text-center">Precio</th>
                                <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase text-center bg-frescoh-light/30">Vendido Ciclo</th>
                                <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase text-center">Disponibilidad</th>
                                <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase text-center w-[250px]">Ajuste de Stock</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200 font-medium">
                            <template x-for="product in filteredProducts" :key="product.id">
                                <tr class="hover:bg-frescoh-light/20 transition-all">
                                    <td class="px-6 py-5">
                                        <div class="flex items-center gap-3">
                                            <div class="w-10 h-10 rounded-xl bg-frescoh-dark/5 flex items-center justify-center text-lg shadow-inner">🥬</div>
                                            <div>
                                                <div class="font-black text-frescoh-dark capitalize text-sm" x-text="product.name"></div>
                                                <div class="text-[9px] text-gray-400 font-mono tracking-tighter" x-text="product.id"></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-6 py-5 text-center">
                                        <span class="text-xs font-black text-frescoh-dark bg-frescoh-light px-2.5 py-1 rounded-lg" x-text="formatCurrency(product.price)"></span>
                                    </td>
                                    
                                    <!-- Vendido Ciclo -->
                                    <td class="px-6 py-5 text-center bg-frescoh-light/10">
                                        <div class="flex flex-col items-center">
                                            <span class="px-3 py-1 rounded-full text-[11px] font-black bg-white border border-frescoh-dark/10 text-frescoh-dark shadow-sm" 
                                                x-text="product.cycleSales || 0">
                                            </span>
                                            <span class="text-[8px] text-gray-400 font-black mt-1 uppercase italic tracking-tighter" x-text="product.packagingType || 'Unidad'"></span>
                                        </div>
                                    </td>
                                    
                                    <!-- Stock Actual -->
                                    <td class="px-6 py-5 text-center">
                                        <div x-show="!product.isEditingStock" @click="product.isEditingStock = true; product.newStockValue = product.stock" class="group cursor-pointer">
                                            <div class="flex flex-col items-center gap-1">
                                                <span :class="product.stock <= 0 ? 'bg-red-50 text-red-600 border-red-200' : (product.stock <= 5 ? 'bg-orange-50 text-orange-600 border-orange-200' : 'bg-green-50 text-green-700 border-green-200')" 
                                                    class="px-4 py-1.5 rounded-xl text-sm font-black block mx-auto w-max border group-hover:scale-105 transition-all shadow-sm" 
                                                    x-text="product.stock">
                                                </span>
                                                <div class="w-16 h-1 bg-gray-100 rounded-full overflow-hidden mt-1">
                                                    <div class="h-full" :class="product.stock <= 5 ? 'bg-red-500' : 'bg-green-500'" :style="'width: ' + Math.min(100, (product.stock/20)*100) + '%'"></div>
                                                </div>
                                            </div>
                                        </div>
                                        <div x-show="product.isEditingStock" class="flex items-center justify-center gap-1" @click.away="product.isEditingStock = false">
                                            <input type="number" x-model.number="product.newStockValue" class="w-16 h-9 border-2 border-frescoh-dark rounded-lg text-center text-sm focus:ring-0 outline-none bg-white font-black">
                                            <button @click="saveStockDirect(product)" class="text-[10px] uppercase font-black bg-frescoh-dark text-frescoh-lime px-3 py-1.5 rounded-lg hover:opacity-80 shadow-md h-9">Ok</button>
                                        </div>
                                    </td>

                                    <td class="px-6 py-5">
                                        <div class="flex items-center justify-center gap-2">
                                            <div class="flex items-center bg-gray-100 rounded-xl p-1 shadow-inner border border-gray-200">
                                                <button @click="updateStock(product.id, -1)" class="w-8 h-8 rounded-lg text-frescoh-dark/40 hover:bg-white hover:text-red-500 hover:shadow-sm transition flex items-center justify-center">
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="4" d="M18 12H6"></path></svg>
                                                </button>
                                                <input type="number" x-model.number="product.inputQty" class="w-10 bg-transparent text-center text-sm focus:outline-none font-black text-frescoh-dark" placeholder="0">
                                                <button @click="updateStock(product.id, 1)" class="w-8 h-8 rounded-lg text-frescoh-dark/40 hover:bg-white hover:text-frescoh-dark hover:shadow-sm transition flex items-center justify-center">
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="4" d="M12 6v12m6-6H6"></path></svg>
                                                </button>
                                            </div>
                                            <button @click="saveBatch(product)" class="text-[10px] uppercase font-black bg-frescoh-lime text-frescoh-dark px-4 py-2.5 rounded-xl hover:scale-105 transition shadow-lg border border-frescoh-dark/10">Actualizar</button>
                                        </div>
                                    </td>
                                </tr>
                            </template>
                        </tbody>
                        <tfoot class="bg-frescoh-dark text-white font-black uppercase tracking-widest text-[10px]">
                            <tr>
                                <th class="px-6 py-6 border-r border-white/5 text-xs">Métricas Totales</th>
                                <th class="px-6 py-6 text-center border-r border-white/5">--</th>
                                <th class="px-6 py-6 text-center bg-white/5 border-r border-white/5 text-frescoh-lime text-sm" x-text="cycleSalesTotal"></th>
                                <th class="px-6 py-6 text-center text-white text-sm" x-text="totalStockValue"></th>
                                <th class="px-6 py-6 text-center">--</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal Nuevo Producto -->
    <div x-show="openModal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4" x-cloak x-transition>
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-y-auto max-h-[90vh] border border-gray-200" @click.away="openModal = false">
            <div class="frescoh-gradient p-6 text-white sticky top-0 border-b border-frescoh-dark">
                <h2 class="text-xl font-black uppercase tracking-tight">Crear Nuevo Producto</h2>
                <p class="text-frescoh-lime/80 text-xs font-medium uppercase mt-1">Catálogo Frescoh!</p>
            </div>
            <form @submit.prevent="createProduct" class="p-6 space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-1">ID / SKU</label>
                        <input type="text" x-model="newProduct.id" required class="w-full border border-gray-300 rounded p-2 focus:ring-2 focus:ring-frescoh-dark outline-none bg-gray-50 text-sm" placeholder="FRU-NOM-500">
                    </div>
                    <div>
                        <label class="block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-1">Nombre</label>
                        <input type="text" x-model="newProduct.name" required class="w-full border border-gray-300 rounded p-2 focus:ring-2 focus:ring-frescoh-dark outline-none bg-gray-50 text-sm" placeholder="Ej: Fresas">
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-1">Precio Unit.</label>
                        <input type="number" x-model="newProduct.price" required class="w-full border border-gray-300 rounded p-2 focus:ring-2 focus:ring-frescoh-dark outline-none bg-gray-50 text-sm" placeholder="15000">
                    </div>
                    <div>
                        <label class="block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-1">Stock Inicial</label>
                        <input type="number" x-model="newProduct.stock" required class="w-full border border-gray-300 rounded p-2 focus:ring-2 focus:ring-frescoh-dark outline-none bg-gray-50 text-sm" placeholder="10">
                    </div>
                </div>
                <div>
                    <label class="block text-[10px] font-black text-gray-500 uppercase tracking-widest mb-1">Tipo Empaque</label>
                    <input type="text" x-model="newProduct.packagingType" class="w-full border border-gray-300 rounded p-2 focus:ring-2 focus:ring-frescoh-dark outline-none bg-gray-50 text-sm" placeholder="Caja, Bandeja, Bolsa...">
                </div>
                <div class="flex flex-col-reverse md:flex-row justify-end gap-3 mt-8 pt-4 border-t border-gray-100">
                    <button type="button" @click="openModal = false" class="text-gray-500 bg-gray-100 px-4 py-2 rounded hover:bg-gray-200 transition font-bold text-xs uppercase tracking-wide">Cancelar</button>
                    <button type="submit" class="bg-frescoh-dark text-frescoh-lime px-6 py-2 rounded font-black hover:opacity-90 shadow-md transition text-xs uppercase tracking-wide">Guardar Producto</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Scripts App -->
    <script>
        function inventoryApp() {
            return {
                products: <%- JSON.stringify(products) %>,
                search: '',
                openModal: false,
                chart: null,
                newProduct: {
                    id: '', name: '', price: 0, stock: 0, packagingType: 'Caja'
                },

                init() {
                    this.initChart();
                    this.products.forEach(p => {
                        p.inputQty = 0;
                        p.isEditingStock = false;
                        p.isEditingCost = false;
                        p.newStockValue = p.stock || 0;
                        p.newCostValue = p.cost || 0;
                    });
                },

                async saveCost(product) {
                    try {
                        const response = await fetch(`/admin/inventory/api/cost/${product.id}`, {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ cost: product.newCostValue })
                        });
                        
                        if (response.ok) {
                            product.cost = product.newCostValue;
                            product.isEditingCost = false;
                            window.frescohNotify({ title: 'Costo Actualizado', message: `Nuevo costo para ${product.name} guardado`, type: 'success' });
                        }
                    } catch (e) {
                        window.frescohNotify({ title: 'Error', message: e.message, type: 'error' });
                    }
                },

                get filteredProducts() {
                    if (!this.search) return this.products;
                    const s = this.search.toLowerCase();
                    return this.products.filter(p => p.name.toLowerCase().includes(s) || p.id.toLowerCase().includes(s));
                },

                get outOfStockCount() {
                    return this.products.filter(p => p.stock <= 5).length;
                },

                get totalSales() {
                    return this.products.reduce((acc, p) => acc + (p.sales || 0), 0);
                },

                get cycleSalesTotal() {
                    return this.products.reduce((acc, p) => acc + (p.cycleSales || 0), 0);
                },

                get todaySalesTotal() {
                    return this.products.reduce((acc, p) => acc + (p.todaySales || 0), 0);
                },

                get totalStockValue() {
                    return this.products.reduce((acc, p) => acc + (p.stock || 0), 0);
                },

                initChart() {
                    const ctx = document.getElementById('stockChart').getContext('2d');
                    this.chart = new Chart(ctx, {
                        type: 'bar',
                        data: this.getChartData(),
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: { 
                                legend: { display: false },
                                tooltip: { mode: 'index', intersect: false }
                            },
                            scales: { 
                                y: { beginAtZero: true, grid: { color: '#f3f4f6' } },
                                x: { grid: { display: false } }
                            }
                        }
                    });
                },

                getChartData() {
                    const labels = this.products.map(p => p.name);
                    const stockData = this.products.map(p => p.stock);
                    const cycleSalesData = this.products.map(p => p.cycleSales || 0);

                    return {
                        labels: labels,
                        datasets: [
                            {
                                type: 'line',
                                label: 'Ventas Ciclo',
                                data: cycleSalesData,
                                borderColor: '#3b82f6',
                                backgroundColor: '#3b82f6',
                                borderWidth: 3,
                                pointRadius: 4,
                                pointBackgroundColor: '#fff',
                                pointBorderColor: '#3b82f6',
                                tension: 0.4,
                                order: 1
                            },
                            {
                                type: 'bar',
                                label: 'Stock Actual',
                                data: stockData,
                                backgroundColor: this.products.map(p => p.stock <= 5 ? '#ef4444' : '#005035'),
                                borderRadius: 4,
                                barPercentage: 0.6,
                                order: 2
                            }
                        ]
                    };
                },

                formatCurrency(value) {
                    return new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', minimumFractionDigits: 0 }).format(value || 0);
                },

                updateStock(productId, delta) {
                    const product = this.products.find(p => p.id === productId);
                    if (product) {
                        product.inputQty = (product.inputQty || 0) + delta;
                    }
                },

                async saveBatch(product) {
                    if (!product.inputQty || product.inputQty === 0) return;
                    try {
                        const response = await fetch(`/admin/inventory/api/stock/${product.id}`, {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ quantityChange: product.inputQty })
                        });
                        
                        if (response.ok) {
                            product.stock += product.inputQty;
                            const absQty = Math.abs(product.inputQty);
                            if (product.inputQty < 0) {
                                product.sales = (product.sales || 0) + absQty;
                                product.cycleSales = (product.cycleSales || 0) + absQty;
                                product.todaySales = (product.todaySales || 0) + absQty;
                            }
                            product.inputQty = 0;
                            this.refreshChart();
                            window.frescohNotify({ title: '¡Éxito!', message: 'Inventario actualizado y sincronizado', type: 'success' });
                        }
                    } catch (e) {
                        window.frescohNotify({ title: 'Error', message: e.message, type: 'error' });
                    }
                },

                async saveStockDirect(product) {
                    try {
                        const response = await fetch(`/admin/inventory/api/stock-direct/${product.id}`, {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ stock: product.newStockValue })
                        });
                        
                        if (response.ok) {
                            product.stock = product.newStockValue;
                            product.isEditingStock = false;
                            this.refreshChart();
                            window.frescohNotify({ title: 'Stock Actualizado', message: `${product.name} sincronizado correctamente`, type: 'success' });
                        }
                    } catch (e) {
                        window.frescohNotify({ title: 'Error', message: e.message, type: 'error' });
                    }
                },

                async createProduct() {
                    try {
                        const response = await fetch('/admin/inventory/api/product', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(this.newProduct)
                        });
                        
                        if (response.ok) {
                            const res = await response.json();
                            this.products.push({ ...res.product, inputQty: 0, todaySales: 0, cycleSales: 0 });
                            this.openModal = false;
                            this.refreshChart();
                            window.frescohNotify({ title: 'Producto Creado', message: 'Catálogo actualizado', type: 'success' });
                            setTimeout(() => location.reload(), 1000); 
                        }
                    } catch (e) {
                        window.frescohNotify({ title: 'Error', message: e.message, type: 'error' });
                    }
                },

                refreshChart() {
                    this.chart.data = this.getChartData();
                    this.chart.update();
                }
            }
        }
    </script>
</body>
</html>
