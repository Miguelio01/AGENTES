<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              frescoh: {
                dark: '#005035',
                lime: '#B5F543',
                light: '#E6F4EA'
              }
            }
          }
        }
      }
    </script>
    <style>
        body { background-color: #f9fafb; font-family: 'Inter', sans-serif; }
        .card { background: white; border-radius: 1rem; border: 1px solid #e5e7eb; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05); }
        .frescoh-gradient { background: linear-gradient(135deg, #005035 0%, #003622 100%); }
        [x-cloak] { display: none !important; }
    </style>
</head>
<body class="p-4 md:p-8" x-data="ordersApp()">
    
    <%- include('partials/ui-stack') %>

    <div class="max-w-7xl mx-auto">
        <!-- Header -->
        <header class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
            <div class="flex items-center gap-4">
                <img src="data:image/png;base64,<%= logo %>" class="w-16 h-16 rounded-full shadow-lg border-2 border-frescoh-lime" alt="Frescoh! Logo">
                <div>
                    <h1 class="text-3xl font-black text-frescoh-dark flex items-center gap-2 uppercase tracking-tight">
                        FRESCOH! <span class="text-frescoh-lime bg-frescoh-dark px-2 py-0.5 rounded">ÓRDENES</span>
                    </h1>
                    <div class="flex items-center gap-2 mt-1">
                        <p class="text-gray-500 font-medium text-xs">Registro y Control de Operaciones</p>
                        <div class="flex items-center gap-1.5 ml-2">
                            <span class="flex h-2 w-2 relative">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
                            </span>
                            <span class="text-[9px] font-bold text-gray-400 uppercase tracking-widest">Live Sync</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="flex flex-wrap items-center gap-3">
                <div class="flex items-center bg-white border border-gray-200 rounded-lg p-1 shadow-sm mr-2">
                  <div class="px-3 py-1 text-right">
                    <p class="text-[9px] font-black text-gray-400 uppercase leading-none"><%= currentUser?.role === 'ADMIN' ? 'ADMINISTRADOR' : 'VENDEDOR' %></p>
                    <p class="text-xs font-bold text-frescoh-dark truncate max-w-[100px]"><%= currentUser?.name || 'Usuario' %></p>
                  </div>
                  <a href="/auth/logout" class="bg-gray-50 hover:bg-red-50 text-gray-400 hover:text-red-500 p-2 rounded-md transition-colors" title="Cerrar Sesión">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                  </a>
                </div>

                <a href="/admin/orders/new" class="bg-frescoh-dark text-frescoh-lime px-4 py-2 rounded-lg font-black shadow-lg hover:scale-105 transition text-xs flex items-center gap-2 uppercase tracking-wide">
                    ➕ Nuevo Pedido
                </a>
                
                <% if (currentUser?.role === 'ADMIN') { %>
                  <a :href="'/admin/orders/export-products-xlsx?cycleId=' + selectedCycleId" class="bg-white border border-orange-200 text-orange-600 px-4 py-2 rounded-lg font-bold shadow-sm hover:bg-orange-50 transition text-xs flex items-center gap-2 uppercase">
                      📦 Despacho
                  </a>
                  <a :href="'/admin/orders/export-xlsx?cycleId=' + selectedCycleId" class="bg-white border border-blue-200 text-blue-600 px-4 py-2 rounded-lg font-bold shadow-sm hover:bg-blue-50 transition text-xs flex items-center gap-2 uppercase">
                      📦 Reporte
                  </a>
                  <a href="/admin/inventory" class="text-frescoh-dark hover:bg-frescoh-light px-4 py-2 rounded-lg font-bold transition border border-gray-200 bg-white shadow-sm text-xs uppercase tracking-tighter italic">Inventario</a>
                  <a href="/admin/clients" class="text-frescoh-dark hover:bg-frescoh-light px-4 py-2 rounded-lg font-bold transition border border-gray-200 bg-white shadow-sm text-xs uppercase tracking-tighter italic">Clientes</a>
                  <% } %>

            </div>
        </header>

        <main>
            <!-- Dashboard Stats -->
            <div class="grid grid-cols-1 md:grid-cols-5 gap-4 mb-8">
                <div class="card p-4 border-l-4 border-l-frescoh-dark flex flex-col justify-center">
                    <p class="text-gray-500 text-[9px] uppercase tracking-wider font-black">Total Pedidos</p>
                    <p class="text-2xl font-bold text-frescoh-dark mt-1" x-text="filteredOrders.length"></p>
                </div>
                <div class="card p-4 border-l-4 border-l-frescoh-lime flex flex-col justify-center">
                    <p class="text-gray-500 text-[9px] uppercase tracking-wider font-black">Ingresos Brutos</p>
                    <p class="text-2xl font-bold text-frescoh-dark mt-1" x-text="formatCurrency(totalRevenue)"></p>
                </div>
                <div class="card p-4 border-l-4 border-l-indigo-500 flex flex-col justify-center bg-indigo-50/10">
                    <p class="text-gray-500 text-[9px] uppercase tracking-wider font-black">Promedio Ticket</p>
                    <p class="text-2xl font-bold text-indigo-600 mt-1" x-text="formatCurrency(filteredOrders.length ? totalRevenue/filteredOrders.length : 0)"></p>
                </div>
                <div class="card p-4 border-l-4 border-l-blue-500 flex flex-col justify-center bg-blue-50/10">
                    <p class="text-gray-500 text-[9px] uppercase tracking-wider font-black">Con Domicilio</p>
                    <p class="text-2xl font-bold text-blue-600 mt-1" x-text="ordersWithDelivery"></p>
                </div>
                <div class="card p-4 border-l-4 border-l-orange-500 flex flex-col justify-center">
                    <p class="text-gray-500 text-[9px] uppercase tracking-wider font-black">Pendientes</p>
                    <p class="text-2xl font-bold text-orange-600 mt-1" x-text="filteredOrders.filter(o => o.status === 'pending').length"></p>
                </div>
            </div>

            <!-- Tabla de Pedidos -->
            <div class="card overflow-hidden mb-12 border-t-4 border-t-frescoh-dark shadow-xl">
                <div class="bg-gray-50 px-6 py-5 border-b border-gray-200 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                    <div class="flex flex-col md:flex-row items-start md:items-center gap-4">
                        <div>
                            <h3 class="font-bold text-frescoh-dark uppercase tracking-tight">📋 Bitácora de Ventas</h3>
                            <p class="text-[10px] text-gray-400 font-bold uppercase mt-0.5">Control de estados y sincronización con Sheets</p>
                        </div>
                        
                        <!-- Filtro por Cosecha -->
                        <div class="flex items-center gap-2 bg-white border border-gray-300 rounded-xl px-3 py-1.5 shadow-sm">
                            <span class="text-[10px] font-black text-gray-400 uppercase">Cosecha:</span>
                            <select x-model="selectedCycleId" class="text-xs font-bold text-frescoh-dark outline-none bg-transparent cursor-pointer">
                                <option value="all">Ver Todas</option>
                                <template x-for="cycle in cycles" :key="cycle.id">
                                    <option :value="cycle.id" x-text="cycle.name + (cycle.status === 'OPEN' ? ' (Activa)' : '')" :selected="activeCycle && cycle.id === activeCycle.id"></option>
                                </template>
                            </select>
                        </div>
                    </div>
                    <div class="relative w-full md:w-80">
                        <input type="text" x-model="search" placeholder="Buscar por ID, Cliente..." class="border border-gray-300 rounded-xl px-4 py-2 text-sm focus:ring-2 focus:ring-frescoh-dark outline-none w-full bg-white shadow-inner">
                    </div>
                </div>
                
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse min-w-[1000px]">
                        <thead class="bg-gray-50 border-b border-gray-200">
                            <tr>
                                <th class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest">Fecha / ID</th>
                                <th class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest">Cliente</th>
                                <th class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest hidden lg:table-cell">Contenido del Pedido</th>
                                <th class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest text-right">Subtotal</th>
                                <th class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest text-right">Domicilio</th>
                                <th class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest text-right">Total</th>
                                <th class="px-6 py-4 text-[10px] font-black text-gray-500 uppercase tracking-widest text-center">Estado Operativo</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200">
                            <template x-for="order in filteredOrders" :key="order.id">
                                <tr class="hover:bg-frescoh-light/20 transition-all border-l-4" 
                                    :class="{
                                        'border-l-orange-400': order.status === 'pending',
                                        'border-l-blue-400': order.status === 'confirmed',
                                        'border-l-frescoh-dark': order.status === 'delivered',
                                        'border-l-red-400': order.status === 'cancelled'
                                    }">
                                    <td class="px-6 py-5">
                                        <div class="font-black text-frescoh-dark text-xs uppercase" x-text="formatDate(order.createdAt).split(',')[0]"></div>
                                        <div class="text-[9px] text-gray-400 font-mono mt-0.5 tracking-tighter" x-text="order.id"></div>
                                    </td>
                                    <td class="px-6 py-5">
                                        <div class="font-black text-gray-800 text-sm capitalize" x-text="order.client.fullName || order.client.name"></div>
                                        <div class="text-[10px] text-gray-500 font-bold flex items-center gap-1">
                                            <span class="opacity-50">📱</span> <span x-text="order.client.phone"></span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-5 text-[11px] text-gray-600 hidden lg:table-cell">
                                        <div class="flex flex-col gap-1.5">
                                            <template x-for="item in order.items">
                                                <div class="flex items-center justify-between bg-gray-50/80 px-2 py-1 rounded-lg border border-gray-100 hover:border-frescoh-dark/20 transition-colors">
                                                    <div class="flex items-center gap-1.5">
                                                        <span class="text-frescoh-dark font-black" x-text="item.quantity + 'x'"></span>
                                                        <span class="text-gray-700 font-bold" x-text="item.name"></span>
                                                    </div>
                                                    <span class="text-[9px] font-mono text-gray-400 bg-white px-1.5 py-0.5 rounded border border-gray-100 shadow-sm ml-4" x-text="formatCurrency(item.price)"></span>
                                                </div>
                                            </template>
                                        </div>
                                    </td>
                                    <td class="px-6 py-5 text-right font-medium text-gray-600 text-xs" x-text="formatCurrency(order.subtotal)"></td>
                                    <td class="px-6 py-5 text-right text-xs">
                                        <div x-show="!order.isEditingFee" class="flex items-center justify-end gap-2 group">
                                            <span x-show="order.deliveryFee > 0" class="text-gray-800 font-black" x-text="formatCurrency(order.deliveryFee)"></span>
                                            <span x-show="order.deliveryFee === 0" class="text-gray-400 italic text-[10px] bg-gray-50 px-2 py-1 rounded-lg border border-dashed border-gray-200">RECOGE</span>
                                            <button @click="order.isEditingFee = true" class="opacity-0 group-hover:opacity-100 text-frescoh-dark hover:scale-125 transition cursor-pointer">✏️</button>
                                        </div>
                                        <div x-show="order.isEditingFee" class="flex items-center justify-end gap-1">
                                            <input type="number" x-model.number="order.newDeliveryFee" class="w-20 border-2 border-frescoh-dark rounded-lg text-right text-xs px-2 py-1 outline-none bg-white font-black">
                                            <button @click="saveDeliveryFee(order)" class="bg-frescoh-dark text-frescoh-lime p-1 rounded-lg hover:opacity-80 shadow-sm cursor-pointer">✅</button>
                                        </div>
                                    </td>
                                    <td class="px-6 py-5 text-right font-black text-frescoh-dark text-sm" x-text="formatCurrency(order.total)"></td>
                                    <td class="px-6 py-5 text-center">
                                        <div class="flex items-center justify-center gap-2">
                                            <div x-show="!order.isEditingStatus">
                                                <span class="px-3 py-1.5 rounded-xl text-[10px] font-black uppercase tracking-widest cursor-pointer hover:scale-105 transition-all shadow-sm border-2"
                                                    @click="order.isEditingStatus = true"
                                                    :class="{
                                                        'bg-orange-50 text-orange-700 border-orange-200': order.status === 'pending',
                                                        'bg-blue-50 text-blue-700 border-blue-200': order.status === 'confirmed',
                                                        'bg-green-50 text-green-700 border-green-200': order.status === 'delivered',
                                                        'bg-red-50 text-red-700 border-red-200': order.status === 'cancelled'
                                                    }" x-text="order.status"></span>
                                            </div>

                                            <!-- Botón de Factura -->
                                            <template x-if="['confirmed', 'delivered'].includes(order.status)">
                                                <a :href="'/admin/orders/api/' + order.id + '/invoice'" 
                                                   class="bg-white border border-gray-200 text-gray-500 hover:text-red-500 p-1.5 rounded-lg hover:border-red-200 transition-all shadow-sm" 
                                                   title="Descargar Factura PDF">
                                                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                                                        <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd"></path>
                                                    </svg>
                                                </a>
                                            </template>
                                        </div>
                                        
                                        <div x-show="order.isEditingStatus" class="flex items-center justify-center gap-1 mt-2">
                                            <select x-model="order.newStatus" class="text-[10px] border-2 border-frescoh-dark rounded-lg px-2 py-1.5 focus:ring-0 outline-none bg-white font-black uppercase shadow-sm">
                                                <option value="pending">Pending</option>
                                                <option value="confirmed">Confirmed</option>
                                                <option value="delivered">Delivered</option>
                                                <option value="cancelled">Cancelled</option>
                                            </select>
                                            <button @click="saveStatus(order)" class="bg-frescoh-dark text-frescoh-lime p-1.5 rounded-lg hover:opacity-80 shadow-md cursor-pointer">✅</button>
                                            <button @click="order.isEditingStatus = false; order.newStatus = order.status" class="text-red-500 hover:scale-125 transition cursor-pointer ml-1">✖</button>
                                        </div>
                                    </td>
                                </tr>
                            </template>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <script>
        function ordersApp() {
            return {
                orders: <%- JSON.stringify(orders) %>,
                cycles: <%- JSON.stringify(cycles) %>,
                activeCycle: <%- JSON.stringify(activeCycle) %>,
                search: '',
                selectedCycleId: 'all',
                
                init() {
                    if (this.activeCycle) {
                        this.selectedCycleId = this.activeCycle.id;
                    }

                    this.orders.forEach(o => {
                        this.enrichOrder(o);
                    });
                },

                enrichOrder(o) {
                    o.subtotal = o.total - o.deliveryFee;
                    o.newDeliveryFee = o.deliveryFee;
                    o.isEditingFee = false;
                    o.isEditingStatus = false;
                    o.newStatus = o.status;
                },

                get filteredOrders() {
                    let filtered = this.orders;
                    if (this.selectedCycleId !== 'all') {
                        filtered = filtered.filter(o => o.salesCycleId === this.selectedCycleId);
                    }
                    if (this.search) {
                        const s = this.search.toLowerCase();
                        filtered = filtered.filter(o => 
                            o.id.toLowerCase().includes(s) || 
                            (o.client.fullName && o.client.fullName.toLowerCase().includes(s)) ||
                            (o.client.phone && o.client.phone.includes(s))
                        );
                    }
                    return filtered;
                },

                get totalRevenue() {
                    return this.filteredOrders.reduce((sum, order) => sum + (order.total || 0), 0);
                },

                get ordersWithDelivery() {
                    return this.filteredOrders.filter(o => o.deliveryFee > 0).length;
                },

                formatCurrency(value) {
                    return new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', minimumFractionDigits: 0 }).format(value || 0);
                },

                formatDate(dateString) {
                    if (!dateString) return 'N/A';
                    const d = new Date(dateString);
                    return d.toLocaleDateString('es-CO', { day: '2-digit', month: 'short', year: 'numeric' }) + ', ' + d.toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit' });
                },

                async saveDeliveryFee(order) {
                    try {
                        const response = await fetch(`/admin/orders/api/${order.id}/delivery-fee`, {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ deliveryFee: order.newDeliveryFee })
                        });
                        
                        if (response.ok) {
                            const res = await response.json();
                            order.deliveryFee = order.newDeliveryFee;
                            order.total = res.newTotal;
                            order.subtotal = order.total - order.deliveryFee;
                            order.isEditingFee = false;
                            window.frescohNotify({ title: 'Domicilio Actualizado', message: 'Total recalculado correctamente', type: 'success' });
                        }
                    } catch (e) {
                        window.frescohNotify({ title: 'Error', message: e.message, type: 'error' });
                    }
                },

                async saveStatus(order) {
                    try {
                        const response = await fetch(`/admin/orders/api/${order.id}/status`, {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ status: order.newStatus })
                        });
                        
                        if (response.ok) {
                            const res = await response.json();
                            if (res.status === 'SUCCESS') {
                                order.status = order.newStatus;
                                order.isEditingStatus = false;
                                // Si se canceló, desaparece de la lista local o marcamos como tal
                                if (order.status === 'cancelled') {
                                    this.orders = this.orders.filter(o => o.id !== order.id);
                                    window.frescohNotify({ title: 'Orden Anulada', message: 'Stock devuelto e historial actualizado', type: 'warning' });
                                } else {
                                    window.frescohNotify({ title: 'Estado Actualizado', message: 'Sincronizado con inventario y Sheets', type: 'success' });
                                }
                            }
                        }
                    } catch (e) {
                        window.frescohNotify({ title: 'Error', message: e.message, type: 'error' });
                    }
                }
            }
        }
    </script>
</body>
</html>
